{
  "name": "bhayanakcast",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.prod.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backup": "vitest run -c vitest.backup.config.ts",
    "test:migrate": "vitest run -c vitest.migrate.config.ts",
    "test:e2e": "playwright test",
    "og:image": "node scripts/og-assets.ts",
    "db:generate": "drizzle-kit generate && biome format --write drizzle",
    "db:migrate": "node src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.9",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jsquash/webp": "^1.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/pacer": "^0.23.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "better-auth": "^1.7.9",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.57.2",
    "srvx": "^1.0.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
