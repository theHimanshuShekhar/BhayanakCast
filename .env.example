# Copy to .env and fill in. Never commit real values.
# Production (Dockhand) takes the same variables as stack variables; see docs/deploy.md,
# which explains where to get each one. Empty values count as unset.

# --- docker compose only ---------------------------------------------------------------
# Where the app is published on the host: the dockhand LXC's LAN IP (ADR 9). The shared
# cloudflared points cast.bhayanak.net at http://HOST_BIND:HOST_PORT.
HOST_BIND=10.1.1.160
HOST_PORT=3000
# Postgres (ADR 8). docker compose builds the app's DATABASE_URL from these.
# Use a URL-safe password (it goes into DATABASE_URL): `openssl rand -hex 24`
POSTGRES_USER=bhayanakcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bhayanakcast
# Nightly pg_dump, rsynced to the NAS (ADR 9). Docker mounts BACKUP_NAS_SHARE (a directory on
# the NAS CIFS share holding the .bhayanakcast-backups marker file) itself; see docs/deploy.md
# section 5 (Backups to the NAS). The password can't contain `,` or `$`.
BACKUP_NAS_SHARE=//10.1.1.195/weyland/Services/backups/bhayanakcast
BACKUP_NAS_USERNAME=
BACKUP_NAS_PASSWORD=
# Cron expression, in BACKUP_TZ. Default nightly at 03:00.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TZ=UTC
# Days of dumps kept, today included.
BACKUP_RETENTION_DAYS=14
# The backup container turns unhealthy when the last successful run is older than this (hours).
BACKUP_MAX_AGE_HOURS=26

# --- app ---------------------------------------------------------------------------------
# For `pnpm dev`/`pnpm start` only; docker compose sets PORT=3000 and its own DATABASE_URL.
PORT=3000
DATABASE_URL=postgres://bhayanakcast:change-me@localhost:5432/bhayanakcast

# Better Auth (ADR 7). Secret must be at least 32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-32-plus-chars
# Public origin. Production: https://cast.bhayanak.net (the compose default).
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth (ADR 6). Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Comma-separated Discord user IDs bootstrapped as admins
ADMIN_DISCORD_IDS=

# Comma-separated IPs or CIDR ranges whose cf-connecting-ip header is trusted: the shared
# cloudflared host (ADR 9). Anyone else is identified by their socket address. Required in
# production; leave empty in development.
TRUSTED_PROXY_IPS=

# Cloudflare TURN (ADR 3)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Admin dashboard's TURN usage panel (optional: without both of these it says "not
# configured"). Account-wide usage, since the free tier is per account. The token is a
# separate, read-only one: Account > Account Analytics > Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=

# Signed-out (lobby-only) realtime sockets allowed per client IP (ADR 20). Default 20.
REALTIME_ANONYMOUS_SOCKETS_PER_IP=

# How long an empty room waits before it ends, in ms (ADR 14). Default 300000 (5 minutes).
REALTIME_EMPTY_ROOM_TIMEOUT_MS=

# Test-only sign-in for Playwright (`E2E_AUTH=1`). Never set it in production: the app refuses
# to start, and docker-compose.yml doesn't pass it through.
