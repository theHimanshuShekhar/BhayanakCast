# Copy to .env and fill in. Never commit real values.
PORT=3000
# Host port docker compose publishes the app on (bound to 127.0.0.1)
APP_PORT=3000

# Postgres (ADR 8). For `pnpm dev` point DATABASE_URL at a local Postgres.
# docker compose builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://bhayanakcast:change-me@localhost:5432/bhayanakcast
POSTGRES_USER=bhayanakcast
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bhayanakcast

# Better Auth (ADR 7). Secret must be at least 32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-string-of-32-plus-chars
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth (ADR 6). Redirect URL: ${BETTER_AUTH_URL}/api/auth/callback/discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Comma-separated Discord user IDs bootstrapped as admins
ADMIN_DISCORD_IDS=

# Cloudflare TURN (ADR 3)
CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=your-turn-api-token

# Cloudflare Tunnel (ADR 9), used by `docker compose --profile tunnel`
TUNNEL_TOKEN=
