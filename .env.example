# Copy to .env and fill in. Never commit real values.
PORT=3000

# Postgres (ADR 0008)
DATABASE_URL=postgres://user:password@localhost:5432/bhayanakcast

# Better Auth (ADR 0007)
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Discord OAuth (ADR 0006)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
# Comma-separated Discord user IDs bootstrapped as admins
ADMIN_DISCORD_IDS=

# Cloudflare TURN (ADR 0003)
CLOUDFLARE_TURN_KEY_ID=your-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=your-turn-api-token
