[Unit]
Description=BhayanakCast encrypted PostgreSQL backup
RequiresMountsFor=/mnt/nas
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bhayanakcast
Group=bhayanakcast
WorkingDirectory=/opt/bhayanakcast
EnvironmentFile=/etc/bhayanakcast/backup.env
ExecStart=/opt/bhayanakcast/scripts/backup-postgres.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
