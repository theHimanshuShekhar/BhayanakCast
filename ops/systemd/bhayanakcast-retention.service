[Unit]
Description=BhayanakCast data-retention run
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=bhayanakcast
Group=bhayanakcast
WorkingDirectory=/opt/bhayanakcast
ExecStart=/usr/bin/docker compose exec -T app node scripts/run-retention.mjs
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
